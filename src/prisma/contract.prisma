// use prisma-next

enum CodigoSetor {
  CLINICA
  BANHO_TOSA
  ADMINISTRATIVO
}

enum EscopoAcesso {
  OWN
  UNIT
  ALL
}

enum TipoPerfil {
  MASTER
  GESTOR
  RECEPCIONISTA
  VETERINARIO
}

model Cliente {
  id              Int      @id @default(autoincrement())
  codigoAntigo    Int?     @unique
  nome            String
  cpf             String?
  telefone        String?
  whatsapp        String?
  email           String?
  cep             String?
  endereco        String?
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  estado          String?
  observacoes     String?
  ativo           Boolean  @default(true)
  pacientes       Paciente[]
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}

model Paciente {
  id                Int      @id @default(autoincrement())
  codigoAntigo      Int?     @unique
  nome              String
  especie           String?
  sexo              String?
  raca              String?
  dataNascimento    DateString?
  corPelagem        String?
  peso              Float?
  microchip         String?
  observacoes       String?
  castrado          Boolean  @default(false)
  ativo             Boolean  @default(true)

  clienteId         Int?
  cliente           Cliente? @relation(fields: [clienteId], references: [id])

  anotacoes         PacienteAnotacao[]
  planos            PacientePlano[]
  atendimentos      PacienteAtendimento[]
  pesagens          PacientePeso[]

  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()
}

model Unidade {
  id              Int      @id @default(autoincrement())
  nome            String
  codigo          String   @unique
  ativo           Boolean  @default(true)
  usuarios        UsuarioUnidade[]
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}

model Setor {
  id              Int      @id @default(autoincrement())
  nome            String
  codigo          CodigoSetor @unique
  ativo           Boolean  @default(true)
  usuarios        UsuarioSetor[]
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}

model Perfil {
  id              Int         @id @default(autoincrement())
  nome            String
  tipo            TipoPerfil
  ativo           Boolean     @default(true)
  usuarioSetores  UsuarioSetor[]
  permissoes      PerfilPermissao[]
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@unique([nome, tipo])
}

model Permissao {
  id              Int      @id @default(autoincrement())
  codigo          String   @unique
  descricao       String?
  ativo           Boolean  @default(true)
  perfis          PerfilPermissao[]
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}

model Usuario {
  id              Int      @id @default(autoincrement())
  nome            String
  email           String   @unique
  senhaHash       String
  ativo           Boolean  @default(true)
  isMaster        Boolean  @default(false)
  setores         UsuarioSetor[]
  unidades        UsuarioUnidade[]
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}

model UsuarioSetor {
  id              Int      @id @default(autoincrement())
  usuarioId       Int
  setorId         Int
  perfilId        Int
  ativo           Boolean  @default(true)

  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  setor           Setor    @relation(fields: [setorId], references: [id])
  perfil          Perfil   @relation(fields: [perfilId], references: [id])

  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@unique([usuarioId, setorId])
}

model UsuarioUnidade {
  id              Int      @id @default(autoincrement())
  usuarioId       Int
  unidadeId       Int

  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  unidade         Unidade  @relation(fields: [unidadeId], references: [id])

  createdAt       TimestamptzString @default(now())

  @@unique([usuarioId, unidadeId])
}

model PerfilPermissao {
  id              Int           @id @default(autoincrement())
  perfilId        Int
  permissaoId     Int
  escopo          EscopoAcesso?

  perfil          Perfil        @relation(fields: [perfilId], references: [id])
  permissao       Permissao     @relation(fields: [permissaoId], references: [id])

  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@unique([perfilId, permissaoId])
}

model PacienteAnotacao {
  id Int @id @default(autoincrement())

  texto String
  ativo Boolean @default(true)

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [id])

  criadoPorUsuarioId Int?
  criadoPorNome      String?

  createdAt TimestamptzString @default(now())
}

model PacientePlano {
  id Int @id @default(autoincrement())

  nome              String
  numeroCarteirinha String?
  validade          DateString?
  observacoes       String?
  ativo             Boolean @default(true)

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model PacienteAtendimento {
  id Int @id @default(autoincrement())

  motivoConsulta      String?
  anamnese            String?
  exameClinico        String?
  diagnosticoSuspeita String?
  conduta             String?
  observacoes         String?

  dataAtendimento TimestamptzString @default(now())

  profissionalUsuarioId Int?
  profissionalNome      String?

  ativo Boolean @default(true)

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model PacientePeso {
  id Int @id @default(autoincrement())

  peso Float
  observacoes String?

  dataPesagem TimestamptzString @default(now())

  profissionalUsuarioId Int?
  profissionalNome      String?

  ativo Boolean @default(true)

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}